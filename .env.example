# AutoSOC Global Environment Configuration
# This file contains safe placeholder defaults for local development.
# DO NOT commit real credentials or secrets to this file.

# Environment configuration
ENVIRONMENT=development
# DEBUG should be false in production
DEBUG=true

# Next.js Frontend Public Variables
# Must be prefixed with NEXT_PUBLIC_ to be accessible in the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_APP_VERSION=0.1.0-dev

# FastAPI Backend Variables
API_V1_STR=/api/v1
PROJECT_NAME="AutoSOC Backend"
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=DEBUG

# Future Database Credentials (Placeholder)
# POSTGRES_SERVER=localhost
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=autosoc

# Future Identity Management (Placeholder)
# KEYCLOAK_SERVER_URL=http://localhost:8080/auth
# KEYCLOAK_REALM=autosoc-realm
# KEYCLOAK_CLIENT_ID=autosoc-api
# KEYCLOAK_CLIENT_SECRET=placeholder

# Future Search Engine (Placeholder)
# OPENSEARCH_URL=https://localhost:9200
# OPENSEARCH_USER=admin
# OPENSEARCH_PASSWORD=admin

# Future Event Streaming (Placeholder)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
