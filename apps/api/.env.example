# AutoSOC FastAPI Backend Environment Configuration
# Safe defaults for local development. Do not add real secrets here.

# Basic Settings
PROJECT_NAME="AutoSOC Backend API"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
APP_VERSION=0.1.0-dev
API_V1_STR=/api/v1
COMMIT_ID=unknown

# CORS Settings (JSON List of allowed origins)
# Explicitly allows the local Next.js development server
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Backing services for the local Compose configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=autosoc_local
POSTGRES_PASSWORD=replace-with-a-unique-password
POSTGRES_DB=auto_soc
REDIS_HOST=localhost
REDIS_PORT=6379
OPENSEARCH_HOSTS=http://localhost:9200
REDPANDA_HOST=localhost
REDPANDA_PORT=19092
HEALTH_CHECK_TIMEOUT_SECONDS=5

# Keycloak validates signed access tokens against the Compose Keycloak service.
KEYCLOAK_SERVER_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=autosoc
KEYCLOAK_CLIENT_ID=autosoc-api
KEYCLOAK_AUDIENCE=account
