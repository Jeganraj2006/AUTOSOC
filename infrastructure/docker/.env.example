# Copy to .env and set unique local-development values. Do not commit .env.
AUTOSOC_POSTGRES_USER=autosoc_local
AUTOSOC_POSTGRES_PASSWORD=replace-with-a-unique-password
AUTOSOC_POSTGRES_DB=autosoc
AUTOSOC_KEYCLOAK_ADMIN_USER=replace-with-a-local-admin-name
AUTOSOC_KEYCLOAK_ADMIN_PASSWORD=replace-with-a-unique-password
AUTOSOC_KEYCLOAK_FRONTEND_CLIENT_SECRET=replace-with-a-unique-client-secret
AUTOSOC_BOOTSTRAP_USER=replace-with-a-local-operator-name
AUTOSOC_BOOTSTRAP_PASSWORD=replace-with-a-unique-password
AUTOSOC_MINIO_ROOT_USER=replace-with-a-local-minio-admin-name
AUTOSOC_MINIO_ROOT_PASSWORD=replace-with-a-unique-password
AUTOSOC_MINIO_DATA_DIR=E:/AUTOSOC/docker-data/minio
